/target

# ephemeral per-story gate report (produced by the stop-gate workflow, not committed)
.claude/current-gate-report.md

# REPL history written to cwd when the binary runs interactively
.kyzo_repl_history

# .kyzo holds local scratch by default; the agent-collaboration app is tracked.
.kyzo/*
!.kyzo/kyzo-plan-agent-collaboration.md
!.kyzo/collab/

# Cursor ↔ Claude Code handoff mailbox (local/remote agent notes, never committed)
CLAUDE-AND-CURSOR.md

# Board context (#140) — generated from GitHub, never truth
__pycache__/
.claude/.focus-gate-cache

# The kyzo MCP server and its config are sourced/deployed separately (like codegraph, via
# deploy.sh) — the source of truth is not this copy, so the whole tree is untracked here.
# This subsumes the vendored codegraph build artifact and the large local model cache within it.
.mcp.json
/mcp/

# VS Code extension build artifact (packaged by vsce, shipped via releases, never committed)
*.vsix

# Ephemeral gate artifacts written by the detector / gate.sh — never committed.
crates/xtask/gate.log*
crates/xtask/gate-counts.txt
/kyzo

# internal agent coordination / handoff — local only, never ship
CLAUDE-AND-CURSOR-HANDOFF.md
/RELEASE-STATE.md
/scratchpad-board/
crates/xtask/bs-counts.txt

# Host UID/GID for docker compose (local only — see docker-compose.yml).
.env

# Cursor agents' scratch build dirs (cargo target copies) — never tracked.
target-*/
.cargo-target-cursor/
.claude/hooks/.pester-last
