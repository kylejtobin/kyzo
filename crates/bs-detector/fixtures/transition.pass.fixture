struct Timestamp(u64);
struct Ledger(u64);

struct SealedLedger {
    at: Timestamp,
}

enum SealRefusal {
    Empty,
}

impl SealedLedger {
    fn from_parts(ledger: Ledger, clock: Timestamp) -> Result<Self, SealRefusal> {
        Ok(SealedLedger { at: clock })
    }
}

impl Ledger {
    fn seal(self, clock: Timestamp) -> Result<SealedLedger, SealRefusal> {
        SealedLedger::from_parts(self, clock)
    }
}
