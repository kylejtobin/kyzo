// Fixture: every rule, one shape per rule, on purpose.
//
// This file is NOT Rust source. The extension is `.rsfix`, so it is not
// compiled, and the detector's walker — which reads `.rs` and nothing else —
// never scans it. That is the whole mechanism: the only legitimate reason to
// write a forbidden shape is to prove a rule fires on it, and such a shape is
// test data, not program text. No marker, no attribute, no exemption.
//
// It MUST parse as a Rust file. The item-tree pass is skipped on anything `syn`
// refuses, so a fixture that does not parse proves only the token rules. This
// file previously held bare statements at file scope, which meant seven rules
// were unproven while the suite reported green.
//
// Line numbers are asserted in `mod law`. Adding a line shifts them; the test
// fails loudly rather than drifting.

#[derive(Ord)]
pub struct Undeclared(u8);
pub struct Exposed(pub Inner);
pub struct Fields {
    pub items: Vec<u8>,
    kind: String,
    flag: bool,
    count: usize,
    shared: RefCell<u8>,
}
struct Inline { n: u64, on: bool }
pub struct Wide(pub u8, bool);
pub enum Payload { V(u64, f32) }
type Alias = bool;
pub enum ParseRefuse { Empty, TooLong }

impl Undeclared {
    pub fn new(v: u8) -> Self { Self(v) }
}

fn f() -> Result<(), String> { Ok(()) }
fn g(count: usize, flag: bool) -> u32 { 0 }

fn statements() {
    let a = x.unwrap();
    let b = x.expect("no");
    panic!("no");
    todo!();
    unimplemented!();
    unreachable!();
    let c = std::env::var("HOME");
    unsafe { }
}

unsafe fn h() {}
unsafe impl Send for T {}
#[allow(unsafe_code)]
struct Lowered { v: u8 }

impl From<u8> for Undeclared { fn from(v: u8) -> Self { Self(v) } }
impl Default for Undeclared { fn default() -> Self { Self(0) } }
impl TryFrom<u16> for Undeclared {
    type Error = ParseRefuse;
    fn try_from(v: u16) -> Result<Self, ParseRefuse> { Err(ParseRefuse::TooLong) }
}
